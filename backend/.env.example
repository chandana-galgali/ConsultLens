# Copy to backend/.env and edit. Never commit the real file.
# Leave ANTHROPIC_API_KEY empty to use the built-in template summary (works fine for the demo).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# SQLite by default. For PostgreSQL:  postgresql+psycopg://user:pass@localhost:5432/consultlens
DATABASE_URL=sqlite:///./consultlens.db

# AWS Textract for handwriting/tables (needs AWS credentials in your environment)
USE_TEXTRACT=false
AWS_REGION=ap-south-1

# WhatsApp via Twilio (optional, later)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
