# Copy to .env using `python setup_local.py` for local development only.
# Never commit secrets. All patient records must be synthetic during the hackathon.
JWT_SECRET=
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
DATABASE_URL=sqlite:///./consultlens.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_UPLOAD_MB=12
MESSAGE_PROVIDER=mock
ANTHROPIC_API_KEY=
USE_TEXTRACT=false
# Optional AI audio draft transcription (use a fake recording in the hackathon)
OPENAI_API_KEY=
AUDIO_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Optional durable object storage for Render; use secure server-only credentials
S3_BUCKET=
S3_ENDPOINT_URL=
# AWS_REGION=ap-south-1 (or configure AWS_REGION on Render)
