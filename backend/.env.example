# Copy to .env using `python setup_local.py` for local development only.
# Never commit secrets. All patient records must be synthetic during the hackathon.
JWT_SECRET=
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
DATABASE_URL=sqlite:///./consultlens.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_UPLOAD_MB=12
MESSAGE_PROVIDER=mock
ANTHROPIC_API_KEY=
USE_TEXTRACT=false
